# ─── Node / npm ───────────────────────────────────────────────────────────────
node_modules/
npm-debug.log*
yarn-error.log
.pnpm-debug.log*

# ─── Environment / Secrets ────────────────────────────────────────────────────
# Block all real env files (contain secrets)
.env
.env.local
.env.development
.env.production
.env.*.local
*.env
# But allow .env.example (safe template — no real secrets)
!.env.example
!**/.env.example

# ─── Build output ─────────────────────────────────────────────────────────────
dist/
build/
.vite/

# ─── OS / Editor ──────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
.vscode/settings.json
*.swp
*.swo

# ─── Logs ─────────────────────────────────────────────────────────────────────
logs/
*.log

# ─── Misc ─────────────────────────────────────────────────────────────────────
coverage/
.cache/
