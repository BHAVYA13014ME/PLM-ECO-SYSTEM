# ─── PLM Backend — Environment Variables ──────────────────────────────────────
# Copy this file to .env for local development
# Set these as Environment Variables in Render dashboard for production

# ─── Server ───────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=production

# ─── Database ─────────────────────────────────────────────────────────────────
# MongoDB Atlas connection string
# Get from: https://cloud.mongodb.com → your cluster → Connect → Drivers
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority

# ─── JWT Secrets ──────────────────────────────────────────────────────────────
# Generate secure random secrets:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=replace_with_a_long_random_secret_min_64_chars
JWT_REFRESH_SECRET=replace_with_a_different_long_random_secret_min_64_chars

# ─── Token Expiry ─────────────────────────────────────────────────────────────
ACCESS_TOKEN_EXPIRY=15m
REFRESH_TOKEN_EXPIRY=7d

# ─── CORS ─────────────────────────────────────────────────────────────────────
# Your deployed frontend URL (no trailing slash)
# e.g. https://plm-eco-system.vercel.app
CLIENT_URL=https://your-app.vercel.app

# Additional allowed frontend origins (comma-separated, optional)
# FRONTEND_URLS=https://preview-branch.vercel.app,https://custom-domain.com
